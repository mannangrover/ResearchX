# Copy this file to .env and fill in what you have. Everything is optional:
# without an LLM key the pipeline uses transparent heuristics.

# LLM provider: openai | openrouter | anthropic | gemini
LLM_PROVIDER=openai
LLM_API_KEY=
# Leave empty to use the provider default
LLM_MODEL=
# Optional comma-separated models to try when the main one is overloaded
LLM_FALLBACK_MODELS=

# Optional — raises GitHub API limit from 60 to 5000 requests/hour
GITHUB_TOKEN=
# Optional — avoids Semantic Scholar 429 rate limits
SEMANTIC_SCHOLAR_API_KEY=
# Optional — free key from https://openalex.org (needed once the shared daily budget runs out)
OPENALEX_API_KEY=

# auto | tfidf | sentence-transformers | gemini (needs LLM_PROVIDER=gemini)
EMBEDDING_BACKEND=auto

# --- Supabase (optional): login + cloud storage. Leave empty for local mode (no login, SQLite) ---
SUPABASE_URL=
# Publishable / anon key (safe to expose to the browser)
SUPABASE_ANON_KEY=
# Secret / service_role key: only used by scripts/create_demo_user.py — never expose it
SUPABASE_SECRET_KEY=
# Shared demo account (create it with: python -m scripts.create_demo_user)
DEMO_EMAIL=demo@researchx.app
DEMO_PASSWORD=

# --- Hosting: already set in the Dockerfile. Leave them unset when running locally ---
# REQUIRE_AUTH=true
# STATIC_DIR=/app/static
# DAILY_LIMIT_PER_USER=30
# DAILY_LIMIT_TOTAL=300
